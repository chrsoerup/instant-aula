# Copy to .env and fill in real values. .env is gitignored.

# --- Aula / MitID ---
# Your MitID username (not your Aula username). Find it at mitid.dk.
AULA_MITID_USERNAME=

# "app" = approve via MitID app (QR code printed on first run, interactive).
# "token" = MitID kodeviser + password (needed if cron can't wait for a phone tap).
AULA_AUTH_METHOD=app

# Only used when AULA_AUTH_METHOD=token.
AULA_MITID_PASSWORD=

# --- Email delivery (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if left blank. The address must still be SMTP_USER
# (your provider requires that), but you can wrap it with a display name --
# quote the whole value if it contains spaces, e.g.:
# SMTP_FROM="instant-aula <you@gmail.com>"
SMTP_FROM=
# Where digests and urgent alerts get sent -- almost always your own address.
SMTP_TO=
