# Copy to .env and fill in real values. .env is gitignored.

# --- Aula / MitID ---
# Your MitID username (not your Aula username). Find it at mitid.dk.
AULA_MITID_USERNAME=

# "app" = approve via MitID app (QR code printed on first run, interactive).
# "token" = MitID kodeviser + password (needed if cron can't wait for a phone tap).
AULA_AUTH_METHOD=app

# Only used when AULA_AUTH_METHOD=token.
AULA_MITID_PASSWORD=

# This file (and the AULA_* vars above) is only for local/WSL-side testing
# of the Python code directly (e.g. `uv run python -m instant_aula.weekly_digest`
# from a dev shell). Real scheduled runs happen inside the Home Assistant
# add-on (see config.yaml/Dockerfile/run.sh at the repo root and the
# "Running as a Home Assistant Add-on" section in README.md), configured via
# the add-on's own Options UI in Home Assistant, not this file.

# --- Home Assistant push notifications ---
# The notify service for the phone that should receive digests/alerts, e.g.
# "mobile_app_your_iphone" -- find it in HA under Settings > Devices &
# Services > your phone, or Developer Tools > Actions, search "notify".
# NOTE: notify() requires a SUPERVISOR_TOKEN env var, which only exists
# inside the add-on container -- running this locally will fail at the
# notify step unless you're testing from inside that container.
HA_NOTIFY_SERVICE=

# --- Local LLM (weekly digest "Husk" highlights) ---
# Optional -- used to pull parent-actionable reminders (bring gym clothes,
# bring the "læsemappe", etc.) out of the week's schedule/notes. Requires
# Ollama running locally with the model pulled (`ollama pull llama3.1:8b`).
# If unset, these defaults are used; if the call fails, the digest still
# sends, just without the "Husk" section.
# 300s default because this runs CPU-only in WSL by default -- a full
# week's notes can take a few minutes to process. Runs once a week via
# cron, so there's no interactive wait; lower this if you have GPU accel.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300
